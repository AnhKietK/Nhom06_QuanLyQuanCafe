USE master;
GO

IF NOT EXISTS (SELECT 1 FROM sys.server_principals WHERE name = 'login_auth')
    CREATE LOGIN login_auth WITH PASSWORD = 'AuthLogin@123', CHECK_POLICY = OFF;
ELSE
    ALTER LOGIN login_auth WITH PASSWORD = 'AuthLogin@123';
GO

